MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/taptempo
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_secure_password
# Required in production: admin login stays disabled unless this is set to 16+ characters
JWT_SECRET=replace_with_a_random_secret_at_least_16_chars

# Client-side (must be prefixed NEXT_PUBLIC_ to be exposed to the browser)
# Optional third-party endpoint for the contact form. Leave unset to show the direct email fallback.
# NEXT_PUBLIC_CONTACT_API=https://your-api.com/contact
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# AI Chat Assistant (OpenCode Zen)
OPencode_API_KEY=your_opencode_zen_api_key
OPencode_API_BASE_URL=https://opencode.ai/zen/v1
OPencode_MODEL=big-pickle
